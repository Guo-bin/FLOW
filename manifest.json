{
  "manifest_version": 3,
  "name": "Article to Flowchart",
  "version": "1.0",
  "description": "Generates a flowchart from an article using Gemini.",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "options_page": "options.html"
}
